# ─── Supabase Local Dev ───────────────────────────────────────────────────────
# Copy this to .env and fill in your actual values.
# NEVER commit the real .env to version control.

# Local dev (supabase start)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key-here

# ─── Production ───────────────────────────────────────────────────────────────
# Replace with your project values from Supabase Dashboard → Settings → API
# SUPABASE_URL=https://<your-project-ref>.supabase.co
# SUPABASE_ANON_KEY=<your-anon-key>
# SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>   ← keep this SECRET

# ─── Frontend (if using Vite) ─────────────────────────────────────────────────
# VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<your-anon-key>
